// GUTSHOT Poker Club — Prisma Schema
// Источник: docs/02-database-design.md, docs/03-prisma-models.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------
// ENUMS
// ---------------------------------

enum TournamentStatus {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  IN_PROGRESS
  FINISHED
  ARCHIVED
}

/// Состояние турнирных часов (структура блайндов крутится сама).
enum ClockStatus {
  IDLE
  RUNNING
  PAUSED
  FINISHED
}

enum RegistrationStatus {
  REGISTERED
  CHECKED_IN
  PLAYING
  FINISHED
  CANCELLED
  NO_SHOW
  WAITING
}

/// Виды ре-энтри / аддона в турнире (для аналитики выручки).
enum ReEntryKind {
  /// Ре-энтри: 1000 ₽ / 30k фишек.
  RE_ENTRY_1000
  /// Ре-энтри: 1500 ₽ / 60k фишек.
  RE_ENTRY_1500
  /// Аддон: 1000 ₽.
  ADDON_1000
}

enum XPReason {
  TOURNAMENT_PARTICIPATION
  TOURNAMENT_PLACE
  TOURNAMENT_WIN
  BONUS
  PENALTY
  MANUAL
  ATTENDANCE
  ELIMINATION
  RE_ENTRY
  BOUNTY
  ACHIEVEMENT
  WEEKLY_RATING
  MONTHLY_FINAL
}

/// Типы событий, фиксируемых в истории активности игрока.
enum PlayerEventType {
  TOURNAMENT_REGISTRATION
  TOURNAMENT_CANCELLED
  ARRIVED
  ELIMINATED
  RE_ENTRY
  BOUNTY
  FOUR_OF_A_KIND
  STRAIGHT_FLUSH
  ROYAL_FLUSH
  XP_CHANGE
  LEVEL_UP
  TOURNAMENT_RESULT
  ACHIEVEMENT_UNLOCKED
  WEEKLY_RATING_REWARD
  MONTHLY_FINAL_REWARD
  TUTORIAL_COMPLETED
  FRIEND_REFERRED
  SHORT_STACK_WIN
}

/// Достижения, выдаваемые за редкие комбинации.
enum AchievementCode {
  FOUR_OF_A_KIND
  STRAIGHT_FLUSH
  ROYAL_FLUSH
}

/// Ключи настраиваемых значений XP.
enum XpSettingKey {
  ATTENDANCE
  ELIMINATION
  RE_ENTRY
  BOUNTY
  FOUR_OF_A_KIND
  STRAIGHT_FLUSH
  ROYAL_FLUSH
  TOURNAMENT_WIN
  PLACE_2
  PLACE_3
  PLACE_4
  PLACE_5
  PLACE_6
  PLACE_7
  PLACE_8
  PLACE_9
  PLACE_10
  PLACE_11
  PLACE_12
  PLACE_13
  PLACE_14
  PLACE_15
  PLACE_16
  PLACE_17
  PLACE_18
  PLACE_19
  PLACE_20
  PLACE_21
  PLACE_22
  PLACE_23
  PLACE_24
  PLACE_25
  PLACE_26
  PLACE_27
  PLACE_28
  PLACE_29
  PLACE_30
  PLACE_31_40
  PLACE_41_50
  PLACE_51_PLUS
  WEEKLY_TOP_1
  WEEKLY_TOP_2
  WEEKLY_TOP_3
  MONTHLY_TOP_1
  MONTHLY_TOP_2
  MONTHLY_TOP_3
}

/// Тип периода для наград рейтинга.
enum RatingPeriodType {
  WEEKLY
  MONTHLY
}

/// Типы юридических документов клуба.
enum LegalDocumentType {
  CLUB_RULES
  USER_AGREEMENT
  PERSONAL_DATA_CONSENT
  MEDIA_CONSENT
}

enum NotificationType {
  REGISTRATION
  REMINDER
  TOURNAMENT_START
  TOURNAMENT_RESULT
  SYSTEM
}

enum AdminRole {
  OWNER
  ADMIN
  MANAGER
  DEALER
}

enum BroadcastStatus {
  DRAFT
  SENDING
  SENT
  FAILED
}

enum BroadcastSegment {
  ALL_ACTIVE
  TOURNAMENT_REGISTERED
  TOURNAMENT_RSVP_PENDING
  SINGLE_PLAYER
}

enum BroadcastButtons {
  NONE
  OPEN_APP
  RSVP
  CUSTOM
}

enum BroadcastDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
  DELETED
}

// ---------------------------------
// MODELS
// ---------------------------------

model User {
  id        String   @id @default(cuid())
  telegramId String  @unique
  username  String?
  firstName String?
  lastName  String?
  /// Отображаемое имя в клубе. Уникально без учёта регистра
  /// (индекс User_nickname_lower_key в миграции). Игрок меняет сам.
  nickname  String?
  photoUrl  String?
  isBlocked Boolean  @default(false)
  isVerified Boolean @default(false)
  /// Владельцы клуба и служебные аккаунты: XP копится, в рейтинге не показываются.
  hiddenFromRating Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Постоянный персональный QR-код игрока. Выдается один раз при создании
  /// пользователя и никогда не меняется при обновлении профиля.
  qrCode String? @unique

  /// Принятие пользовательских соглашений при первом входе в Mini App.
  consentAcceptedAt DateTime?

  // ── Web-аккаунт (сайт клуба) ─────────────────────────────
  /// bcrypt-хэш пароля. null — вход только через Telegram.
  passwordHash String?
  /// Почта для восстановления доступа. Уникальна, если задана.
  email String? @unique
  /// Телефон для входа по коду, формат +7XXXXXXXXXX. Один номер — один игрок.
  phone String? @unique
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  /// Откуда создан аккаунт: бот или сайт.
  source Source @default(TELEGRAM)

  passwordResetTokens PasswordResetToken[]
  consentLogs         ConsentLog[]

  /// Витрина достижений: id из клиентского каталога, которые игрок закрепил
  /// в профиле. Видны другим игрокам в списке участников турнира.
  pinnedAchievements String[] @default([])

  playerProfile      PlayerProfile?
  registrations      Registration[]
  tournamentResults  TournamentResult[]
  xpHistory          XPHistory[]
  notifications      Notification[]
  achievements       Achievement[]
  playerAchievements         PlayerAchievement[]
  ratingRewards              RatingReward[]
  weeklyFinalQualifications  WeeklyFinalQualification[]
  monthlyFinalQualifications MonthlyFinalQualification[]
  events                     PlayerEvent[]
  broadcastDeliveries        BroadcastDelivery[]
  targetedBroadcasts         BroadcastCampaign[] @relation("BroadcastTargetUser")

  @@index([telegramId])
  @@index([qrCode])
}

model PlayerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  xp        Int      @default(0)
  /// Суммарные счетчики за все время участия в турнирах.
  reEntries Int      @default(0)
  bounties  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Tournament {
  id                 String           @id @default(cuid())
  title              String
  description        String?
  date               DateTime
  buyIn              Int
  maxPlayers         Int
  status             TournamentStatus @default(DRAFT)
  registrationOpen   DateTime?
  registrationClose  DateTime?
  reminderSentAt     DateTime?
  /// URL обложки турнира (админка).
  imageUrl           String?
  /// Live-состояние стола (блайнды / перерывы).
  liveIsRunning      Boolean          @default(false)
  liveLevel          Int?
  liveSmallBlind     Int?
  liveBigBlind       Int?
  liveAnte           Int?
  liveNextBreakInSec Int?
  livePlayersIn      Int?
  liveUpdatedAt      DateTime?

  /// Турнирные часы. Структура уровней задаётся заранее (BlindLevel),
  /// дальше блайнды и перерывы переключаются сами от clockStartedAt.
  clockStatus     ClockStatus @default(IDLE)
  /// Момент старта текущего уровня (с учётом пауз).
  clockStartedAt  DateTime?
  /// Индекс текущего уровня в структуре (0-based, включая перерывы).
  clockLevelIdx   Int         @default(0)
  /// Когда часы поставили на паузу (null, если идут).
  clockPausedAt   DateTime?

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  registrations     Registration[]
  tournamentResults TournamentResult[]
  events            PlayerEvent[]
  blindLevels       BlindLevel[]
  broadcastCampaigns BroadcastCampaign[]
  reEntryLogs       ReEntryLog[]

  @@index([date])
  @@index([status])
}

/// Уровень структуры турнира: блайнды либо перерыв.
model BlindLevel {
  id           String  @id @default(cuid())
  tournamentId String
  /// Порядок в структуре (0-based), включая перерывы.
  idx          Int
  isBreak      Boolean @default(false)
  smallBlind   Int?
  bigBlind     Int?
  ante         Int?
  durationSec  Int

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, idx])
  @@index([tournamentId])
}

model Registration {
  id             String             @id @default(cuid())
  userId         String
  tournamentId   String
  status         RegistrationStatus @default(REGISTERED)
  registeredAt   DateTime           @default(now())
  checkedInAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  /// Отметка о явке игрока на турнир. Заполняется один раз — по ней
  /// гарантируется, что XP за посещение начисляется не более одного раза.
  arrivedAt          DateTime?
  attendanceXpGiven  Boolean   @default(false)
  eliminatedAt       DateTime?
  /// Место в турнире (можно проставить до finish — XP начислится при завершении).
  place              Int?
  reEntries          Int       @default(0)
  bounties           Int       @default(0)

  user       User        @relation(fields: [userId], references: [id])
  tournament Tournament  @relation(fields: [tournamentId], references: [id])
  qrToken    QRToken?
  reEntryLogs ReEntryLog[]

  @@unique([userId, tournamentId])
  @@index([tournamentId])
  @@index([status])
}

model QRToken {
  id             String   @id @default(cuid())
  registrationId String   @unique
  token          String   @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime @default(now())

  registration Registration @relation(fields: [registrationId], references: [id])

  @@index([token])
  @@index([expiresAt])
}

model TournamentResult {
  id           String   @id @default(cuid())
  tournamentId String
  userId       String
  place        Int
  xpEarned     Int
  createdAt    DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id])
  tournament Tournament  @relation(fields: [tournamentId], references: [id])
  xpHistory  XPHistory[]

  @@unique([userId, tournamentId])
  @@index([tournamentId])
  @@index([place])
}

model XPHistory {
  id                  String   @id @default(cuid())
  userId              String
  tournamentResultId  String?
  reason              XPReason
  amount              Int
  createdAt           DateTime @default(now())

  user             User              @relation(fields: [userId], references: [id])
  tournamentResult TournamentResult? @relation(fields: [tournamentResultId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  sentAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([sentAt])
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(MANAGER)
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  performedEvents       PlayerEvent[]
  updatedDocuments      LegalDocument[]
  updatedAchievements   AchievementText[]
  broadcastCampaigns    BroadcastCampaign[]
  shiftEntries          ShiftEntry[]
  reEntryLogs           ReEntryLog[]

  @@index([email])
}

/// Полная история активности игрока: регистрации, явка, вылеты,
/// ре-энтри, баунти, комбинации, изменения XP и повышения уровня.
model PlayerEvent {
  id           String          @id @default(cuid())
  userId       String
  tournamentId String?
  type         PlayerEventType
  /// Начисленный за событие XP. 0 — если событие не влияет на опыт.
  xpAmount     Int             @default(0)
  /// Произвольные детали события (место, уровень, код достижения).
  metadata     Json?
  /// Сотрудник клуба, выполнивший действие. NULL — системное событие.
  performedById String?
  createdAt    DateTime        @default(now())

  user        User        @relation(fields: [userId], references: [id])
  tournament  Tournament? @relation(fields: [tournamentId], references: [id])
  performedBy AdminUser?  @relation(fields: [performedById], references: [id])

  @@index([userId, createdAt])
  @@index([tournamentId])
  @@index([type])
}

/// Разблокированное достижение игрока. Уникальность пары
/// (игрок, достижение) гарантирует отсутствие дублей.
model Achievement {
  id           String          @id @default(cuid())
  userId       String
  code         AchievementCode
  tournamentId String?
  unlockedAt   DateTime        @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, code])
  @@index([userId])
}

/// Достижение из каталога клуба (id строкой, см. ACHIEVEMENTS_CATALOG).
/// XP начисляется один раз — уникальность пары (игрок, достижение).
model PlayerAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  xpAwarded     Int      @default(0)
  unlockedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
}

/// Выплаченная награда за место в недельном рейтинге или финале месяца.
/// periodKey: «2026-W32» для недели, «2026-08» для месяца.
model RatingReward {
  id         String           @id @default(cuid())
  userId     String
  periodType RatingPeriodType
  periodKey  String
  place      Int
  xpAwarded  Int
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, periodType, periodKey])
  @@index([periodType, periodKey])
}

/// Закрытие недели: топ-7 недельного рейтинга переносят очки в финал месяца.
/// Повторное закрытие той же weekKey идемпотентно (уникальность weekKey+userId).
model WeeklyFinalQualification {
  id         String   @id @default(cuid())
  weekKey    String
  monthKey   String
  userId     String
  /// Место в топ-7 недели (1..7).
  weekPlace  Int
  /// Очки за эту неделю — суммируются в финале месяца.
  weekPoints Int
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([weekKey, userId])
  @@index([monthKey])
  @@index([userId])
  @@index([weekKey])
}

/// Итоги месяца: топ-27 месячного рейтинга получают место в Финале месяца.
/// monthKey = '2026-09' — месяц, за который начислено (финал проходит в следующем).
model MonthlyFinalQualification {
  id        String   @id @default(cuid())
  monthKey  String
  userId    String
  /// Место в месячном рейтинге (1..27).
  place     Int
  /// Очки рейтинга за весь месяц.
  points    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([monthKey, userId])
  @@index([monthKey])
  @@index([userId])
}

/// Настраиваемые значения XP. Редактируются из админ-панели без изменения кода.
model XpSetting {
  key       XpSettingKey @id
  value     Int
  updatedAt DateTime     @updatedAt @default(now())
}

/// Настраиваемая таблица уровней: сколько XP требуется для каждого уровня.
model LevelThreshold {
  level      Int      @id
  requiredXp Int
  title      String?
  updatedAt  DateTime @updatedAt @default(now())

  @@index([requiredXp])
}

/// Юридические документы клуба. Тексты хранятся в БД и сразу
/// отображаются в Mini App после сохранения.
model LegalDocument {
  type        LegalDocumentType @id
  title       String
  content     String
  version     Int               @default(1)
  updatedById String?
  updatedAt   DateTime          @updatedAt @default(now())
  createdAt   DateTime          @default(now())

  updatedBy AdminUser? @relation(fields: [updatedById], references: [id])
}

/// Редактируемые тексты достижений (название, описание, как получить).
/// Логика прогресса остаётся в коде Mini App по id.
model AchievementText {
  id          String   @id
  icon        String
  title       String
  description String
  howTo       String
  updatedById String?
  updatedAt   DateTime @updatedAt @default(now())
  createdAt   DateTime @default(now())

  updatedBy AdminUser? @relation(fields: [updatedById], references: [id])
}

/// Рассылка из админки (анонс, всем или одному по Telegram ID).
model BroadcastCampaign {
  id             String           @id @default(cuid())
  title          String
  bodyHtml       String
  segment        BroadcastSegment
  tournamentId   String?
  /// Конкретный игрок (для сегмента SINGLE_PLAYER).
  targetUserId   String?
  /// Telegram ID конкретного получателя (для сегмента SINGLE_PLAYER).
  targetTelegramId String?
  /// URL картинки для sendPhoto (Telegram скачает сам).
  photoUrl       String?
  /// Локальный путь к загруженному фото (относительно uploads/).
  photoPath      String?
  /// Telegram file_id фото — чтобы не загружать файл при каждой отправке.
  photoFileId    String?
  buttons        BroadcastButtons @default(NONE)
  /// Свои кнопки: [{ text, type?: "url"|"open_app", url?: string }]
  customButtons  Json?
  status         BroadcastStatus  @default(DRAFT)
  createdById    String?
  recipientCount Int              @default(0)
  sentCount      Int              @default(0)
  failedCount    Int              @default(0)
  sentAt         DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  tournament Tournament?         @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  targetUser User?               @relation("BroadcastTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  createdBy  AdminUser?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  deliveries BroadcastDelivery[]

  @@index([status])
  @@index([createdAt])
  @@index([tournamentId])
  @@index([targetUserId])
}

model BroadcastDelivery {
  id                String                  @id @default(cuid())
  campaignId        String
  /// null, если получатель не найден в базе (отправка по «голому» Telegram ID).
  userId            String?
  telegramId        String
  status            BroadcastDeliveryStatus @default(PENDING)
  telegramMessageId Int?
  chatId            String?
  error             String?
  sentAt            DateTime?
  createdAt         DateTime                @default(now())

  campaign BroadcastCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User?             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([userId])
  @@index([status])
}

// ---------------------------------
// WEB AUTH (сайт клуба)
// ---------------------------------

/// Откуда создан аккаунт игрока.
enum Source {
  TELEGRAM
  WEB
}

/// Зачем выдан одноразовый SMS-код.
enum OtpPurpose {
  LOGIN
  LINK_PHONE
}

/// Одноразовый код подтверждения телефона (вход или привязка).
model PhoneOtpCode {
  id         String     @id @default(cuid())
  phone      String
  codeHash   String
  purpose    OtpPurpose @default(LOGIN)
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([phone, purpose, createdAt])
}

/// Одноразовый токен ссылки «восстановить пароль» (30 минут).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Журнал согласий (оферта, правила, ПДн, фото/видео) с версией документа.
model ConsentLog {
  id        String   @id @default(cuid())
  userId    String?
  kind      String
  version   String
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

/// Запись ре-энтри/аддона с видом и стоимостью — для аналитики выручки.
model ReEntryLog {
  id             String      @id @default(cuid())
  tournamentId   String
  registrationId String?
  userId         String?
  /// Игрок на момент записи (снимок имени — на случай удаления профиля).
  playerName     String?
  kind           ReEntryKind
  /// Сумма оплаты, ₽.
  amount         Int
  /// Выданные фишки.
  chips          Int
  createdAt      DateTime    @default(now())
  createdById    String?

  createdBy    AdminUser?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  tournament   Tournament    @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  registration Registration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)

  @@index([tournamentId])
  @@index([createdAt])
}

/// Учётная запись смены сотрудника (имя, дата, сумма за день) — для аналитики.
model ShiftEntry {
  id        String   @id @default(cuid())
  /// Имя сотрудника — свободный ввод.
  name      String
  date      DateTime @db.Date
  /// Сумма за день, ₽ (может быть отрицательной для корректировок).
  amount    Int
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Кто создал запись (админ-пользователь).
  createdById String?

  createdBy AdminUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([name])
}
