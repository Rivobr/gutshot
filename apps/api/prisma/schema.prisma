// GUTSHOT Poker Club — Prisma Schema
// Источник: docs/02-database-design.md, docs/03-prisma-models.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------
// ENUMS
// ---------------------------------

enum TournamentStatus {
  DRAFT
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  IN_PROGRESS
  FINISHED
  ARCHIVED
}

enum RegistrationStatus {
  REGISTERED
  CHECKED_IN
  PLAYING
  FINISHED
  CANCELLED
  NO_SHOW
  WAITING
}

enum XPReason {
  TOURNAMENT_PARTICIPATION
  TOURNAMENT_PLACE
  TOURNAMENT_WIN
  BONUS
  PENALTY
  MANUAL
  ATTENDANCE
  ELIMINATION
  RE_ENTRY
  BOUNTY
  ACHIEVEMENT
}

/// Типы событий, фиксируемых в истории активности игрока.
enum PlayerEventType {
  TOURNAMENT_REGISTRATION
  TOURNAMENT_CANCELLED
  ARRIVED
  ELIMINATED
  RE_ENTRY
  BOUNTY
  FOUR_OF_A_KIND
  STRAIGHT_FLUSH
  ROYAL_FLUSH
  XP_CHANGE
  LEVEL_UP
  TOURNAMENT_RESULT
  ACHIEVEMENT_UNLOCKED
}

/// Достижения, выдаваемые за редкие комбинации.
enum AchievementCode {
  FOUR_OF_A_KIND
  STRAIGHT_FLUSH
  ROYAL_FLUSH
}

/// Ключи настраиваемых значений XP.
enum XpSettingKey {
  ATTENDANCE
  ELIMINATION
  RE_ENTRY
  BOUNTY
  FOUR_OF_A_KIND
  STRAIGHT_FLUSH
  ROYAL_FLUSH
  TOURNAMENT_WIN
  PLACE_2
  PLACE_3
  PLACE_4
  PLACE_5
  PLACE_6
  PLACE_7
  PLACE_8
  PLACE_9
  PLACE_10
  PLACE_11
  PLACE_12
  PLACE_13
  PLACE_14
  PLACE_15
  PLACE_16
  PLACE_17
  PLACE_18
  PLACE_19
  PLACE_20
}

/// Типы юридических документов клуба.
enum LegalDocumentType {
  CLUB_RULES
  USER_AGREEMENT
  PERSONAL_DATA_CONSENT
  MEDIA_CONSENT
}

enum NotificationType {
  REGISTRATION
  REMINDER
  TOURNAMENT_START
  TOURNAMENT_RESULT
  SYSTEM
}

enum AdminRole {
  OWNER
  ADMIN
  MANAGER
}

// ---------------------------------
// MODELS
// ---------------------------------

model User {
  id        String   @id @default(cuid())
  telegramId String  @unique
  username  String?
  firstName String?
  lastName  String?
  /// Отображаемое имя в клубе. Уникально без учёта регистра
  /// (индекс User_nickname_lower_key в миграции). Игрок меняет сам.
  nickname  String?
  photoUrl  String?
  isBlocked Boolean  @default(false)
  isVerified Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Постоянный персональный QR-код игрока. Выдается один раз при создании
  /// пользователя и никогда не меняется при обновлении профиля.
  qrCode String? @unique

  /// Принятие пользовательских соглашений при первом входе в Mini App.
  consentAcceptedAt DateTime?

  playerProfile     PlayerProfile?
  registrations     Registration[]
  tournamentResults TournamentResult[]
  xpHistory         XPHistory[]
  notifications     Notification[]
  achievements      Achievement[]
  events            PlayerEvent[]

  @@index([telegramId])
  @@index([qrCode])
}

model PlayerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  xp        Int      @default(0)
  /// Суммарные счетчики за все время участия в турнирах.
  reEntries Int      @default(0)
  bounties  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Tournament {
  id                 String           @id @default(cuid())
  title              String
  description        String?
  date               DateTime
  buyIn              Int
  maxPlayers         Int
  status             TournamentStatus @default(DRAFT)
  registrationOpen   DateTime?
  registrationClose  DateTime?
  reminderSentAt     DateTime?
  /// URL обложки турнира (админка).
  imageUrl           String?
  /// Live-состояние стола (блайнды / перерывы).
  liveIsRunning      Boolean          @default(false)
  liveLevel          Int?
  liveSmallBlind     Int?
  liveBigBlind       Int?
  liveAnte           Int?
  liveNextBreakInSec Int?
  livePlayersIn      Int?
  liveUpdatedAt      DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  registrations     Registration[]
  tournamentResults TournamentResult[]
  events            PlayerEvent[]

  @@index([date])
  @@index([status])
}

model Registration {
  id             String             @id @default(cuid())
  userId         String
  tournamentId   String
  status         RegistrationStatus @default(REGISTERED)
  registeredAt   DateTime           @default(now())
  checkedInAt    DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  /// Отметка о явке игрока на турнир. Заполняется один раз — по ней
  /// гарантируется, что XP за посещение начисляется не более одного раза.
  arrivedAt          DateTime?
  attendanceXpGiven  Boolean   @default(false)
  eliminatedAt       DateTime?
  reEntries          Int       @default(0)
  bounties           Int       @default(0)

  user       User        @relation(fields: [userId], references: [id])
  tournament Tournament  @relation(fields: [tournamentId], references: [id])
  qrToken    QRToken?

  @@unique([userId, tournamentId])
  @@index([tournamentId])
  @@index([status])
}

model QRToken {
  id             String   @id @default(cuid())
  registrationId String   @unique
  token          String   @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime @default(now())

  registration Registration @relation(fields: [registrationId], references: [id])

  @@index([token])
  @@index([expiresAt])
}

model TournamentResult {
  id           String   @id @default(cuid())
  tournamentId String
  userId       String
  place        Int
  xpEarned     Int
  createdAt    DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id])
  tournament Tournament  @relation(fields: [tournamentId], references: [id])
  xpHistory  XPHistory[]

  @@unique([userId, tournamentId])
  @@index([tournamentId])
  @@index([place])
}

model XPHistory {
  id                  String   @id @default(cuid())
  userId              String
  tournamentResultId  String?
  reason              XPReason
  amount              Int
  createdAt           DateTime @default(now())

  user             User              @relation(fields: [userId], references: [id])
  tournamentResult TournamentResult? @relation(fields: [tournamentResultId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  sentAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([sentAt])
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(MANAGER)
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  performedEvents       PlayerEvent[]
  updatedDocuments      LegalDocument[]
  updatedAchievements   AchievementText[]

  @@index([email])
}

/// Полная история активности игрока: регистрации, явка, вылеты,
/// ре-энтри, баунти, комбинации, изменения XP и повышения уровня.
model PlayerEvent {
  id           String          @id @default(cuid())
  userId       String
  tournamentId String?
  type         PlayerEventType
  /// Начисленный за событие XP. 0 — если событие не влияет на опыт.
  xpAmount     Int             @default(0)
  /// Произвольные детали события (место, уровень, код достижения).
  metadata     Json?
  /// Сотрудник клуба, выполнивший действие. NULL — системное событие.
  performedById String?
  createdAt    DateTime        @default(now())

  user        User        @relation(fields: [userId], references: [id])
  tournament  Tournament? @relation(fields: [tournamentId], references: [id])
  performedBy AdminUser?  @relation(fields: [performedById], references: [id])

  @@index([userId, createdAt])
  @@index([tournamentId])
  @@index([type])
}

/// Разблокированное достижение игрока. Уникальность пары
/// (игрок, достижение) гарантирует отсутствие дублей.
model Achievement {
  id           String          @id @default(cuid())
  userId       String
  code         AchievementCode
  tournamentId String?
  unlockedAt   DateTime        @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, code])
  @@index([userId])
}

/// Настраиваемые значения XP. Редактируются из админ-панели без изменения кода.
model XpSetting {
  key       XpSettingKey @id
  value     Int
  updatedAt DateTime     @updatedAt @default(now())
}

/// Настраиваемая таблица уровней: сколько XP требуется для каждого уровня.
model LevelThreshold {
  level      Int      @id
  requiredXp Int
  title      String?
  updatedAt  DateTime @updatedAt @default(now())

  @@index([requiredXp])
}

/// Юридические документы клуба. Тексты хранятся в БД и сразу
/// отображаются в Mini App после сохранения.
model LegalDocument {
  type        LegalDocumentType @id
  title       String
  content     String
  version     Int               @default(1)
  updatedById String?
  updatedAt   DateTime          @updatedAt @default(now())
  createdAt   DateTime          @default(now())

  updatedBy AdminUser? @relation(fields: [updatedById], references: [id])
}

/// Редактируемые тексты достижений (название, описание, как получить).
/// Логика прогресса остаётся в коде Mini App по id.
model AchievementText {
  id          String   @id
  icon        String
  title       String
  description String
  howTo       String
  updatedById String?
  updatedAt   DateTime @updatedAt @default(now())
  createdAt   DateTime @default(now())

  updatedBy AdminUser? @relation(fields: [updatedById], references: [id])
}
