# ---------------------------------
# GUTSHOT Poker Club — Environment Variables Example
# ---------------------------------

# App
NODE_ENV=development
API_PORT=3000
# На проде обязательно https, иначе /start не работает:
# API_URL=https://api.gutshotapp.ru
API_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://gutshot:gutshot@localhost:5432/gutshot?schema=public
POSTGRES_USER=gutshot
POSTGRES_PASSWORD=gutshot
POSTGRES_DB=gutshot
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d
JWT_ADMIN_SECRET=change_me_admin
# Сессия админки живёт долго: сотрудники клуба работают с телефона
# и не должны логиниться каждый день.
JWT_ADMIN_EXPIRES_IN=30d

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Опционально полный URL webhook (если API_URL не https):
# TELEGRAM_WEBHOOK_URL=https://api.gutshotapp.ru/api/v1/telegram/webhook
MINI_APP_URL=https://app.gutshotapp.ru
# Temporary alternate Mini App front (Cloudflare quick/named tunnel) while
# direct HTTPS is broken for some clients. Leave empty when app.* is orange-clouded.
# MINI_APP_PUBLIC_URL=https://xxxx.trycloudflare.com

# Mini App — use same-origin on prod so CF front and app share one host
VITE_API_URL=http://localhost:3000/api/v1
# VITE_API_URL=/api/v1

# Optional: Cloudflare named tunnel token (docker compose --profile cloudflare)
# CLOUDFLARE_TUNNEL_TOKEN=

# Admin Panel
# Локально — прямой API. В Docker/prod лучше same-origin: /api/v1
VITE_ADMIN_API_URL=http://localhost:3000/api/v1
